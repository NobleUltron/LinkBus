# ==============================================================================
# LinkBus Uganda — Production Environment Blueprint
# Copy this file to .env on your production server and fill in live credentials.
# ==============================================================================

# ── Application Configuration ──────────────────────────────────────────────────
APP_NAME="LinkBus Uganda"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://linkbus.co.ug

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database Configuration (MySQL 8.0+) ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=linkbus_prod
DB_USERNAME=linkbus_db_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# ── Session, Cache & Queue (Redis Recommended for High Concurrency) ────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Authentication, CORS & Sanctum ─────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=linkbus.co.ug,www.linkbus.co.ug
FRONTEND_URL=https://linkbus.co.ug
VITE_API_URL=https://linkbus.co.ug/api
VITE_APP_NAME="${APP_NAME}"

# ── Mail Configuration (SMTP / Gmail / Mailgun / SendGrid) ─────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@linkbus.co.ug
MAIL_PASSWORD=your_16_character_smtp_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@linkbus.co.ug"
MAIL_FROM_NAME="${APP_NAME}"

# ── SMS Gateway Configuration (Africa's Talking / Twilio) ──────────────────────
SMS_ENABLED=true
SMS_PROVIDER=africastalking
SMS_SENDER_ID=LINKBUS

# Africa's Talking API Credentials
AFRICASTALKING_USERNAME=linkbus_ug
AFRICASTALKING_API_KEY=your_africastalking_production_api_key

# Twilio Credentials (Alternative Provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Mobile Money Payment Gateways (MTN MoMo & Airtel Money) ───────────────────
# MTN Mobile Money Open API
MTN_MOMO_API_KEY=your_mtn_momo_api_key
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_momo_subscription_key
MTN_MOMO_USER_ID=your_mtn_momo_user_id
MTN_MOMO_TARGET_ENV=production
MTN_MOMO_CALLBACK_URL=https://linkbus.co.ug/api/payments/webhook/mtn

# Airtel Money Merchant API
AIRTEL_MONEY_CLIENT_ID=your_airtel_client_id
AIRTEL_MONEY_CLIENT_SECRET=your_airtel_client_secret
AIRTEL_MONEY_ENV=production
AIRTEL_MONEY_CALLBACK_URL=https://linkbus.co.ug/api/payments/webhook/airtel

# ── Two-Factor Authentication (2FA) & Security Policy ─────────────────────────
TWO_FACTOR_ENABLED_BY_DEFAULT=false
TWO_FACTOR_EXPIRY_MINUTES=10
