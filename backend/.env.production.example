# ====================================================================
# LinkBus Production Environment Configuration (.env)
# ====================================================================

# ── Application Environment ──────────────────────────────────────────
APP_NAME="LinkBus Services"
APP_ENV=production
APP_KEY=base64:P9M+B1s8OPd21K9ADddkZKQpkgTBeo32wetEJz9FtVc=
APP_DEBUG=false
APP_URL=https://linkbus.co.ug

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ── Logging ─────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (MySQL / MariaDB 10.4+) ────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=linkbus_prod
DB_USERNAME=linkbus_user
DB_PASSWORD=your_strong_database_password_here

# ── Session & Cache ─────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.linkbus.co.ug
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# ── SMTP Email Gateway (Gmail / SendGrid / Postmark) ────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_company_email@gmail.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@linkbus.co.ug"
MAIL_FROM_NAME="LinkBus Uganda"

# ── SMS Gateway (Africa's Talking / Twilio) ──────────────────────────
AFRICASTALKING_USERNAME=linkbus
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_SENDER_ID=LINKBUS

TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_NUMBER=+1234567890

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_permanent_access_token

# ── Frontend & Security ──────────────────────────────────────────────
FRONTEND_URL=https://linkbus.co.ug
SANCTUM_STATEFUL_DOMAINS=linkbus.co.ug,app.linkbus.co.ug
CORS_ALLOWED_ORIGINS=https://linkbus.co.ug,https://app.linkbus.co.ug
